{
  "expo": {
    "name": "Ostrom",
    "slug": "ostrom",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ostrom",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "run.ostrom.app",
      "supportsTablet": true
    },
    "android": {
      "package": "run.ostrom.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ostrom uses Face ID to confirm that you are the one saying yes or no."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
