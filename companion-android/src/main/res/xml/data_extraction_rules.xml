<!-- Android 12 and newer: neither the encrypted tokens nor the account list go to a cloud backup or a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ostrom_credentials.xml"/>
        <exclude domain="sharedpref" path="ostrom.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ostrom_credentials.xml"/>
        <exclude domain="sharedpref" path="ostrom.xml"/>
    </device-transfer>
</data-extraction-rules>
