// SPDX-License-Identifier: AGPL-3.0-only
// The Apple team is TeamCode's for now (Nathan, 2026-11-13), until Ostrom has its own (docs/distribution.md).
// A contributor without access to it sets their own OSTROM_DEVELOPMENT_TEAM and TEAM_ID (any suffix): the bundle
// identifier then becomes unique to that team, so a local build never collides with the published app.
OSTROM_DEVELOPMENT_TEAM=Z8T3MHFW48
TEAM_ID=

PRODUCT_NAME=Ostrom
PRODUCT_BUNDLE_IDENTIFIER=run.ostrom.app$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
// x-release-please-start-version
MARKETING_VERSION=0.1.0
// x-release-please-end
